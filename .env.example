# Copy to .env and adjust. No API keys are required for default operation.
PORT=3000
CORS_ORIGIN=*

# OSRM routing backend (free, no key). Public demo server has fair-use limits.
OSRM_BASE_URL=https://router.project-osrm.org/route/v1/driving
OSRM_TIMEOUT_MS=12000

# Overpass API for live OpenStreetMap charging-station lookup (free, no key).
OVERPASS_URL=https://overpass.kumi.systems/api/interpreter
OVERPASS_TIMEOUT_MS=15000
OVERPASS_USER_AGENT=VoltRoute-EV-Locator/1.0 (Bengaluru EV charging map)
LIVE_STATION_CACHE_TTL_MS=300000

# Optional: Google Places API (New) gives reliable real EV-station locations.
# Enable Places API (New), keep this key server-side, and restrict it to Places API.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_TIMEOUT_MS=12000

# Accounts + station listings (MySQL). Create database `voltroute` first
# (e.g. in MySQL Workbench: CREATE DATABASE voltroute;), then point here.
# Core map/routing APIs work without it.
DATABASE_URL=mysql://root:@localhost:3306/voltroute
# Signs login tokens. Set a long random value; never commit the real one.
JWT_SECRET=
JWT_EXPIRES=7d
# Python interpreter used by the local NumPy ML scorer. Leave blank when
# `python` is available on PATH; otherwise use an absolute path.
PYTHON_BIN=

# Optional: CARTO basemaps key for Voyager tiles. Served through
# /api/basemap-tile/* so the key never reaches the browser.
# Blank = key-free CARTO light tiles.
CARTO_BASEMAPS_KEY=
CARTO_TIMEOUT_MS=10000

# Optional: TomTom traffic-flow overlay on the map + live congestion for the
# ML candidate ranking. Free key (no card) at https://developer.tomtom.com —
# keep it server-side; browsers only see /api/traffic-tile/* from this backend.
# Blank = Traffic toggle stays hidden and the ranker uses simulated traffic.
TOMTOM_API_KEY=
TOMTOM_TIMEOUT_MS=10000

# Optional: OpenChargeMap API key enables /api/stations?source=ocm live lookup.
# Get a free key at https://openchargemap.org/site/develop/api — else leave blank.
OCM_API_KEY=
OCM_BASE_URL=https://api.openchargemap.io/v3/poi
OCM_TIMEOUT_MS=12000
